# ===== Mumble Web 环境变量示例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交
#
# 部署形态：web（静态页面，nginx）+ proxy（Go 代理）两个容器。
# 语音 UDP 与信令始终由浏览器直连 proxy 主机，不经过 web。

# 上游 Mumble 服务器。不带端口时自动做 SRV 解析（_mumble._tcp.<name>）
MUMBLE_SERVER=localhost:64738

# 上游 TLS 策略，三选一：
#   verify          正常校验证书（证书有效时使用）
#   pin:<sha256>    固定证书指纹（证书过期/自签的过渡期方案）
#   insecure        跳过校验（仅调试）
MUMBLE_TLS=verify

# web 容器对外 HTTP 端口（浏览器访问 http://<host>:<PORT>）
PORT=8080

# proxy 容器的 HTTP 端口（单主机部署时仅供 web 容器回源，无需对外；
# 分离部署时浏览器直连此端口，防火墙需放行）
PROXY_PORT=8081

# 浏览器直连代理的完整地址（分离部署时填写，如 http://proxy.example.com:8081
# 或 https://proxy.example.com）。留空 = 与页面同源，由 web 容器回源到本机代理。
# 注意：页面前置 HTTPS 时这里必须填 https，否则被浏览器混合内容策略拦截。
PROXY_ORIGIN=

# WebRTC ICE UDP 端口（浏览器语音需要直连 proxy 主机的此端口，防火墙需放行 UDP）
RTC_UDP_PORT=50000

# 代理部署在 NAT 之后时，填写其公网 IP；直连部署留空
RTC_PUBLIC_IP=

# 是否允许网页端在连接页自选上游服务器（true/false）
# false 时锁定为上面的 MUMBLE_SERVER，连接页输入将被忽略
ALLOW_SERVER_OVERRIDE=true

# ===== 一次性邀请链接 =====
# 网页邀请：已登录用户可在主界面顶栏生成链接。默认开启；
# 设为 false 只关闭网页创建入口，已有链接校验、受邀登录与恢复不受影响。
WEB_INVITE_ENABLED=true

# bot 创建接口（POST /api/invites）的 Bearer 密钥；留空则关闭 bot 创建。
# 不影响网页邀请；密钥只部署在代理与 bot 后端，不要下发给普通用户。
INVITE_SECRET=

# 邀请链接有效期（Go duration 格式，默认 30m）
INVITE_TTL=30m

# 生成邀请链接时使用的前端页面地址（如 https://chat.example.com）；
# 留空时网页邀请优先按浏览器 WS Origin 推断，再回退请求 Host。
# bot 直连 proxy 创建邀请且两者地址不同时，建议显式设置。
FRONTEND_URL=
