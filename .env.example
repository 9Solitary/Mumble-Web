# ===== Mumble Web 环境变量示例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# 上游 Mumble 服务器。不带端口时自动做 SRV 解析（_mumble._tcp.<name>）
MUMBLE_SERVER=localhost:64738

# 上游 TLS 策略，三选一：
#   verify          正常校验证书（证书有效时使用）
#   pin:<sha256>    固定证书指纹（证书过期/自签的过渡期方案）
#   insecure        跳过校验（仅调试）
MUMBLE_TLS=verify

# 对外 HTTP 端口（浏览器访问 http://<host>:<PORT>）
PORT=8080

# WebRTC ICE UDP 端口（浏览器语音需要直连此端口，防火墙需放行 UDP）
RTC_UDP_PORT=50000

# 代理部署在 NAT 之后时，填写其公网 IP；直连部署留空
RTC_PUBLIC_IP=

# 是否允许网页端在连接页自选上游服务器（true/false）
# false 时锁定为上面的 MUMBLE_SERVER，连接页输入将被忽略
ALLOW_SERVER_OVERRIDE=true

# ===== 一次性邀请链接（供 QQ 机器人等 bot 后端调用）=====
# 创建邀请接口（POST /api/invites）的 Bearer 密钥；留空则关闭邀请功能
# 密钥只部署在代理与 bot 后端，不要下发给普通用户
INVITE_SECRET=

# 邀请链接有效期（Go duration 格式，默认 30m）
INVITE_TTL=30m
