# ===== Mumble Web 环境变量示例 =====
# 复制为 .env 后按需修改：cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# 上游 Mumble 服务器。不带端口时自动做 SRV 解析（_mumble._tcp.<name>）
MUMBLE_SERVER=voice.azsyc.com

# 上游 TLS 策略，三选一：
#   verify          正常校验证书（服务器证书续期后使用）
#   pin:<sha256>    固定证书指纹（证书过期/自签的过渡期方案，当前默认值对应 voice.azsyc.com 现网证书）
#   insecure        跳过校验（仅调试）
MUMBLE_TLS=pin:BC:3C:29:BC:A9:C7:C4:73:95:90:E8:B0:4A:65:14:E1:E8:8C:30:F3:BA:94:AB:8B:26:B4:8A:6D:B7:AE:4D:CF

# 对外 HTTP 端口（浏览器访问 http://<host>:<PORT>）
PORT=8080

# WebRTC ICE UDP 端口（浏览器语音需要直连此端口，防火墙需放行 UDP）
RTC_UDP_PORT=50000

# 代理部署在 NAT 之后时，填写其公网 IP；直连部署留空
RTC_PUBLIC_IP=
